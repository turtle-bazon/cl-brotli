(eval-when (:compile-toplevel :load-toplevel :execute)
  (sb-c::defknown (cl-brotli.lisp::%asm-fragment-fast
                   cl-brotli.lisp::%asm-fragment-record
                   cl-brotli.lisp::%asm-fast-emit
                   cl-brotli.lisp::%asm-quick-h2 cl-brotli.lisp::%asm-quick-h3
                   cl-brotli.lisp::%asm-quick-h4 cl-brotli.lisp::%asm-quick-h54
                   cl-brotli.lisp::%asm-triv-plan cl-brotli.lisp::%asm-triv-emit
                   cl-brotli.lisp::%asm-h6-q5 cl-brotli.lisp::%asm-h6-q6
                   cl-brotli.lisp::%asm-h6-q7 cl-brotli.lisp::%asm-h6-q8
                   cl-brotli.lisp::%asm-h6-q9)
      ((simple-array (unsigned-byte 64) (*)) simple-vector)
      (values) ()
      :overwrite-fndb-silently t)

  (defvar *q-st*) (defvar *q-ctx*) (defvar *q-rcx*)
  (defconstant +q-d+ (- (* vector-data-offset n-word-bytes) other-pointer-lowtag))
  (defun q-sv (slot)
    (ea (+ +q-d+ (* 8 (or (position slot *q0-st-slots*) (error "no slot ~S" slot))))
        *q-st*))
  (defun q-cx (slot)
    (ea (+ +q-d+ (* 8 (or (position slot *q0-ctx-slots*) (error "no slot ~S" slot))))
        *q-ctx*))

  (defvar *q-shift* nil)
  (defun q-hash (dst i data tmp)
    ;; DST = the fast-fragment hash of the 5 bytes at I (I <= n - 5),
    ;; %HASHF-SAP: ((load64 << 24) * 0x1E35A7BD) >> shift.  Near the end
    ;; the 5 bytes come from a 4-byte and a 1-byte load.  With *Q-SHIFT*
    ;; the shift is an immediate, else ST[SHIFT] (clobbering RCX).
    (let ((tail (gen-label)) (have (gen-label)))
      (inst cmp i (q-sv :n8))
      (inst jmp :a tail)
      (inst mov dst (ea +q-d+ data i))
      (inst jmp have)
      (emit-label tail)
      (inst mov :dword dst (ea +q-d+ data i))
      (inst movzx '(:byte :dword) tmp (ea (+ 4 +q-d+) data i))
      (inst shl tmp 32)
      (inst or dst tmp)
      (emit-label have)
      (inst shl dst 24)
      (inst imul dst dst #x1E35A7BD)
      (if *q-shift*
          (inst shr dst *q-shift*)
          (progn (inst mov *q-rcx* (q-sv :shift))
                 (inst shr dst :cl)))))

  (defvar *q-k* 5)
  (defun q-prefix-match (a b data tmp tmp2 fail)
    ;; to FAIL unless the *Q-K* (5 or 6) bytes at A and B are equal (A < B
    ;; <= n - K).  One 8-byte compare, except within 8 bytes of the end,
    ;; where no load may pass the vector.
    (let ((near (gen-label)) (ok (gen-label)))
      (inst cmp b (q-sv :n8))
      (inst jmp :a near)
      (inst mov tmp (ea +q-d+ data a))
      (inst xor tmp (ea +q-d+ data b))
      (inst shl tmp (- 64 (* 8 *q-k*)))
      (inst jmp :nz fail)
      (inst jmp ok)
      (emit-label near)
      (inst mov :dword tmp (ea +q-d+ data a))
      (inst cmp :dword tmp (ea +q-d+ data b))
      (inst jmp :ne fail)
      (if (= *q-k* 5)
          (progn (inst movzx '(:byte :dword) tmp (ea (+ 4 +q-d+) data a))
                 (inst movzx '(:byte :dword) tmp2 (ea (+ 4 +q-d+) data b)))
          (progn (inst movzx '(:word :dword) tmp (ea (+ 4 +q-d+) data a))
                 (inst movzx '(:word :dword) tmp2 (ea (+ 4 +q-d+) data b))))
      (inst cmp tmp tmp2)
      (inst jmp :ne fail)
      (emit-label ok)))

  (defvar *q-x0* nil) (defvar *q-x1* nil)
  (defun q-match-len (len a b data tmp)
    ;; LEN = common prefix of A.. and B.. (A < B), at most n - B
    ;; (%MATCH-LEN-SAP-FRAG).  A and B are advanced.  With *Q-X0* / *Q-X1*
    ;; (XMM temporaries) 16 bytes per step first (SSE2, as %MATCH-LEN-SAP).
    (let ((words (gen-label)) (tail (gen-label)) (diff (gen-label)) (done (gen-label)))
      (inst xor len len)
      (when *q-x0*
        (let ((sse (gen-label)) (mism (gen-label)) (sse32 (gen-label))
              (mism16 (gen-label)))
          ;; 32 bytes per bounds check (two 16-byte compares)
          (emit-label sse32)
          (inst lea tmp (ea 32 b))
          (inst cmp tmp (q-sv :n))
          (inst jmp :a sse)
          (inst movdqu *q-x0* (ea +q-d+ data a))
          (inst movdqu *q-x1* (ea +q-d+ data b))
          (inst pcmpeqb *q-x0* *q-x1*)
          (inst pmovmskb tmp *q-x0*)
          (inst cmp tmp #xFFFF)
          (inst jmp :ne mism)
          (inst movdqu *q-x0* (ea (+ 16 +q-d+) data a))
          (inst movdqu *q-x1* (ea (+ 16 +q-d+) data b))
          (inst pcmpeqb *q-x0* *q-x1*)
          (inst pmovmskb tmp *q-x0*)
          (inst cmp tmp #xFFFF)
          (inst jmp :ne mism16)
          (inst add len 32)
          (inst add a 32)
          (inst add b 32)
          (inst jmp sse32)
          (emit-label mism16)
          (inst add len 16)
          (inst add a 16)
          (inst add b 16)
          (inst jmp mism)
          (emit-label sse)
          (inst lea tmp (ea 16 b))
          (inst cmp tmp (q-sv :n))
          (inst jmp :a words)
          (inst movdqu *q-x0* (ea +q-d+ data a))
          (inst movdqu *q-x1* (ea +q-d+ data b))
          (inst pcmpeqb *q-x0* *q-x1*)
          (inst pmovmskb tmp *q-x0*)
          (inst cmp tmp #xFFFF)
          (inst jmp :ne mism)
          (inst add len 16)
          (inst add a 16)
          (inst add b 16)
          (inst jmp sse)
          (emit-label mism)
          (inst not tmp)
          (inst bsf tmp tmp)
          (inst add len tmp)
          (inst jmp done)))
      (emit-label words)
      (inst lea tmp (ea 8 b))
      (inst cmp tmp (q-sv :n))
      (inst jmp :a tail)
      (inst mov tmp (ea +q-d+ data a))
      (inst xor tmp (ea +q-d+ data b))
      (inst jmp :nz diff)
      (inst add len 8)
      (inst add a 8)
      (inst add b 8)
      (inst jmp words)
      (emit-label diff)
      (inst bsf tmp tmp)
      (inst shr tmp 3)
      (inst add len tmp)
      (inst jmp done)
      (emit-label tail)
      (inst cmp b (q-sv :n))
      (inst jmp :ae done)
      (inst movzx '(:byte :dword) tmp (ea +q-d+ data a))
      (inst cmp :byte tmp (ea +q-d+ data b))
      (inst jmp :ne done)
      (inst inc len)
      (inst inc a)
      (inst inc b)
      (inst jmp tail)
      (emit-label done)))

  (defun q-write (bits len acc nb wpos out)
    ;; ACC |= BITS << NB; NB += LEN (LEN <= 32; NB < 32 before and after).
    ;; Clobbers BITS RCX.
    (let ((ok (gen-label)))
      (inst mov *q-rcx* nb)
      (inst shl bits :cl)
      (inst or acc bits)
      (inst add nb len)
      (inst cmp nb 32)
      (inst jmp :b ok)
      (inst mov (ea +q-d+ out wpos) acc)
      (inst add wpos 4)
      (inst shr acc 32)
      (inst sub nb 32)
      (emit-label ok)))

  (defun q-put (bits len acc nb)
    ;; ACC |= BITS << NB; NB += LEN, no flush (the caller bounds the
    ;; pending total below 64).  Clobbers BITS RCX.
    (inst mov *q-rcx* nb)
    (inst shl bits :cl)
    (inst or acc bits)
    (inst add nb len))

  (defun q-flush (acc nb wpos out)
    ;; branchless: store 8 bytes at OUT[WPOS] (>= 8 bytes of slack), keep
    ;; the NB mod 8 pending bits.  Clobbers RCX.
    (inst mov (ea +q-d+ out wpos) acc)
    (inst mov *q-rcx* nb)
    (inst shr *q-rcx* 3)
    (inst add wpos *q-rcx*)
    (inst shl *q-rcx* 3)
    (inst shr acc :cl)
    (inst and nb 7))

  (defun q-put-lut (entry tmp acc nb)
    ;; a table word (bits << 8 | flag << 7 | len), no flush.  Clobbers
    ;; ENTRY TMP RCX.
    (inst movzx '(:byte :dword) tmp entry)
    (inst and tmp 127)
    (inst shr entry 8)
    (q-put entry tmp acc nb))

  (defun q-write-lut (entry tmp acc nb wpos out)
    ;; write a table word: bits << 8 | flag << 7 | len.  Clobbers ENTRY TMP.
    (inst movzx '(:byte :dword) tmp entry)
    (inst and tmp 127)
    (inst shr entry 8)
    (q-write entry tmp acc nb wpos out)))

