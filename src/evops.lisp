(defmacro define-fragment-scan-vop (name translate record k shift)
  `(define-vop (,name)
    ;; %LZ77-FRAGMENT-FAST's scan - trawl with C's skip heuristic, match,
    ;; emit, hash the copied positions, back-to-back copies - entered at
    ;; ST[MODE]: 0 the top of the scan loop (P NEXT-HASH), 1 inside a trawl
    ;; (NEXT-IP SKIP NEXT-HASH), 2 the back-to-back copy check (P CAND2).
    ;; Exit 0: scan done (LIT-START / LAST-DIST for the remainder); exit 1:
    ;; CHUNK-END reached, resume at ST[MODE] when the writer has room.
    (:policy :fast-safe)
    (:translate ,translate)
    (:args (st :scs (descriptor-reg))
           (ctx :scs (descriptor-reg)))
    (:arg-types simple-array-unsigned-byte-64 simple-vector)
    (:temporary (:sc unsigned-reg :offset rcx-offset) rcx)
    (:temporary (:sc unsigned-reg) p)
    (:temporary (:sc unsigned-reg) nip)
    (:temporary (:sc unsigned-reg) skip)
    (:temporary (:sc unsigned-reg) nh)
    (:temporary (:sc unsigned-reg) h)
    (:temporary (:sc unsigned-reg) t1)
    (:temporary (:sc unsigned-reg) t2)
    (:temporary (:sc unsigned-reg) data)
    (:temporary (:sc unsigned-reg) tab)
    (:temporary (:sc int-sse-reg) x0)
    (:temporary (:sc int-sse-reg) x1)
    (:generator 1000
      (let ((record ,record) (*q-k* ,k) (*q-shift* ,shift) (*q-x0* x0) (*q-x1* x1) (*q-st* st) (*q-ctx* ctx) (*q-rcx* rcx)
            (outer (gen-label)) (trawl (gen-label)) (found (gen-label))
            (try-table (gen-label)) (repeat (gen-label)) (no-repeat (gen-label))
            (scan-done (gen-label)) (chunk-exit (gen-label)) (finish (gen-label))
            (m1 (gen-label)) (m2 (gen-label)) (emit (gen-label)) (end (gen-label))
            (rec (gen-label)))
        (labels ((reload ()
                   (inst mov data (q-cx :data))
                   (inst mov tab (q-cx :table)))
                 (prefetch-next ()
                   ;; P + CPY is where the back-to-back copy check looks
                   ;; next: prefetch the data at its table entry while the
                   ;; command is emitted (an empty entry, -1, is a harmless
                   ;; prefetch)
                   (let ((no (gen-label)))
                     (inst mov t1 (q-sv :tmp))
                     (inst add t1 skip)
                     (inst cmp t1 (q-sv :limit))
                     (inst jmp :ge no)
                     (q-hash t2 t1 data h)
                     (inst mov :dword t2 (ea +q-d+ tab t2 4))
                     (inst prefetch :t0 (ea +q-d+ data t2))
                     (emit-label no)))
                 (hash-copied ()
                   ;; table[hash(q)] = q for q in max(0, p - back) .. p-1,
                   ;; then T2 = table[hash(p)] (cand2), table[hash(p)] = p
                   (let ((hl (gen-label)) (hd (gen-label)) (z (gen-label)))
                     (inst mov t2 p)
                     (inst sub t2 (q-sv :back))
                     (inst jmp :ge z)
                     (inst xor t2 t2)
                     (emit-label z)
                     (emit-label hl)
                     (inst cmp t2 p)
                     (inst jmp :ge hd)
                     (q-hash h t2 data t1)
                     (inst mov :dword (ea +q-d+ tab h 4) t2)
                     (inst inc t2)
                     (inst jmp hl)
                     (emit-label hd))
                   (q-hash h p data t1)
                   (inst mov :dword t2 (ea +q-d+ tab h 4))
                   (inst mov :dword (ea +q-d+ tab h 4) p)))
          (reload)
          (inst mov p (q-sv :p))
          (inst mov t1 (q-sv :mode))
          (inst cmp t1 1)
          (inst jmp :e m1)
          (inst cmp t1 2)
          (inst jmp :e m2)
          ;; ---------------------------------------------- top: a new trawl
          (emit-label outer)
          (inst cmp p (q-sv :chunk-end))
          (inst jmp :ge chunk-exit)
          (inst mov nh (q-sv :next-hash))
          (inst mov skip 32)
          (inst mov nip p)
          (inst jmp trawl)
          (emit-label m1)
          (inst mov nip (q-sv :next-ip))
          (inst mov skip (q-sv :skip))
          (inst mov nh (q-sv :next-hash))
          (emit-label trawl)
          (let ((go (gen-label)))
            ;; room check before the step changes anything: resumable
            (inst cmp nip (q-sv :chunk-end))
            (inst jmp :le go)
            (inst mov (q-sv :next-ip) nip)
            (inst mov (q-sv :skip) skip)
            (inst mov (q-sv :next-hash) nh)
            (inst mov :qword (q-sv :mode) 1)
            (inst mov t1 1)
            (inst jmp finish)
            (emit-label go))
          (inst mov h nh)
          (inst mov t1 skip)
          (inst shr t1 5)                          ; step
          (inst inc skip)
          (inst mov p nip)
          (inst add nip t1)
          (inst cmp nip (q-sv :limit))
          (inst jmp :g scan-done)
          (q-hash nh nip data t1)
          ;; the next step's candidate: prefetch its data (the table line
          ;; is usually in L2; the input is not)
          (inst mov :dword t2 (ea +q-d+ tab nh 4))
          (inst prefetch :t0 (ea +q-d+ data t2))
          ;; C checks the previous distance before the table
          (inst mov t1 (q-sv :last-dist))
          (inst test t1 t1)
          (inst jmp :le try-table)
          (inst mov t2 p)
          (inst sub t2 t1)
          (q-prefix-match p t2 data t1 rcx try-table)
          (inst mov :dword (ea +q-d+ tab h 4) p)
          (inst mov t1 t2)                         ; cand
          (inst jmp found)
          (emit-label try-table)
          (inst mov :dword t2 (ea +q-d+ tab h 4))  ; c2
          (inst mov :dword (ea +q-d+ tab h 4) p)
          (inst cmp :dword t2 -1)
          (inst jmp :e trawl)
          (q-prefix-match p t2 data t1 rcx trawl)
          (inst mov t1 p)
          (inst sub t1 t2)
          (inst cmp t1 (q-sv :window))
          (inst jmp :a trawl)
          (inst mov t1 t2)                         ; cand
          ;; ---------------------------------------------- match at P, cand T1
          (emit-label found)
          (inst mov (q-sv :tmp) p)
          (inst mov h p)
          (inst sub h t1)
          (inst mov (q-sv :dist) h)
          (inst mov t2 p)
          (inst sub t2 (q-sv :lit-start))
          (inst mov (q-sv :ins) t2)
          (inst add t1 (q-sv :k))
          (inst mov nip p)
          (inst add nip (q-sv :k))
          (q-match-len skip t1 nip data t2)
          (inst add skip (q-sv :k))
          (inst mov (q-sv :cpy) skip)
          (prefetch-next)
          (inst call (if record rec emit))
          (reload)
          (inst mov p (q-sv :tmp))
          (inst add p (q-sv :cpy))
          (inst mov (q-sv :lit-start) p)
          (inst cmp p (q-sv :limit))
          (inst jmp :ge scan-done)
          (hash-copied)
          (inst jmp repeat)
          (emit-label m2)
          (inst mov t2 (q-sv :cand2))
          ;; ---------------------------------------------- back-to-back copies
          (emit-label repeat)
          (inst cmp :dword t2 -1)
          (inst jmp :e no-repeat)
          (inst cmp t2 p)
          (inst jmp :ge no-repeat)
          (inst mov t1 p)
          (inst sub t1 t2)
          (inst cmp t1 (q-sv :window))
          (inst jmp :a no-repeat)
          (q-prefix-match p t2 data t1 rcx no-repeat)
          (let ((go (gen-label)))
            (inst cmp p (q-sv :chunk-end))
            (inst jmp :l go)
            (inst mov (q-sv :cand2) t2)
            (inst mov :qword (q-sv :mode) 2)
            (inst mov t1 1)
            (inst jmp finish)
            (emit-label go))
          (inst mov (q-sv :tmp) p)
          (inst mov h p)
          (inst sub h t2)
          (inst mov (q-sv :dist) h)
          (inst mov :qword (q-sv :ins) 0)
          (inst mov (q-sv :lit-start) p)
          (inst add t2 (q-sv :k))
          (inst mov nip p)
          (inst add nip (q-sv :k))
          (q-match-len skip t2 nip data t1)
          (inst add skip (q-sv :k))
          (inst mov (q-sv :cpy) skip)
          (prefetch-next)
          (inst call (if record rec emit))
          (reload)
          (inst mov p (q-sv :tmp))
          (inst add p (q-sv :cpy))
          (inst mov (q-sv :lit-start) p)
          (inst cmp p (q-sv :limit))
          (inst jmp :ge scan-done)
          (hash-copied)
          (inst jmp repeat)
          (emit-label no-repeat)
          (inst inc p)
          (inst cmp p (q-sv :limit))
          (inst jmp :g scan-done)
          (q-hash nh p data t1)
          (inst mov (q-sv :next-hash) nh)
          (inst jmp outer)
          ;; ---------------------------------------------- exits
          (emit-label chunk-exit)
          (inst mov :qword (q-sv :mode) 0)
          (inst mov t1 1)
          (inst jmp finish)
          (emit-label scan-done)
          (inst xor t1 t1)
          (emit-label finish)
          (inst mov (q-sv :p) p)
          (inst mov (q-sv :exit) t1)
          (inst jmp end)
          ;; ---------------------------------------------- emit one command
          ;; (subroutine: CALL / RET).  ST: INS literals from LIT-START,
          ;; CPY, DIST, LAST-DIST; writer in WPOS WACC WNBITS.  The mirror
          ;; of EMIT-ONE: insert>0 -> insert code, literals, distance (dist0
          ;; for the last one), copy-last code (+ dist0 when its command
          ;; implies an explicit distance); insert=0 -> copy code, full
          ;; distance.  Clobbers every temporary.
          (emit-label emit)
          (let ((acc p) (nb nip) (wpos skip) (out nh)
                (long-ins (gen-label)) (ins-63 (gen-label)) (ins-done (gen-label))
                (lits (gen-label)) (lits-done (gen-label)) (full-dist (gen-label))
                (dist-done (gen-label)) (clast-long (gen-label)) (copy-tail (gen-label))
                (zero-ins (gen-label)) (copy-long (gen-label)) (store (gen-label)))
            (inst mov acc (q-sv :wacc))
            (inst mov nb (q-sv :wnbits))
            (inst mov wpos (q-sv :wpos))
            (inst mov out (q-cx :out))
            ;; writer: < 8 pending bits between groups, branchless
            ;; Q-FLUSH at the end of each (see %ASM-FAST-EMIT)
            (labels ((flush () (q-flush acc nb wpos out))
                     (dist0 ()
                       (inst mov t1 (q-cx :distlut))
                       (inst mov t1 (ea +q-d+ t1))
                       (q-put-lut t1 t2 acc nb)
                       (flush))
                     (distance ()
                       ;; d = dist + 3, nb = bsr(d) - 1, prefix = bit nb of d,
                       ;; code index 2nb + prefix + 14, extra d - (2+prefix)<<nb
                       (inst mov h (q-sv :dist))
                       (inst add h 3)
                       (inst bsr t1 h)
                       (inst dec t1)
                       (inst mov rcx t1)
                       (inst mov t2 h)
                       (inst shr t2 :cl)
                       (inst and t2 1)
                       (inst lea tab (ea 14 t2 t1 2))
                       (inst add t2 2)
                       (inst shl t2 :cl)
                       (inst sub h t2)                ; extra
                       (inst mov (q-sv :tmp2) t1)     ; its width
                       (inst mov t1 (q-cx :distlut))
                       (inst mov t1 (ea +q-d+ t1 tab 8))
                       (q-put-lut t1 t2 acc nb)
                       (inst mov t1 h)
                       (inst mov t2 (q-sv :tmp2))
                       (q-put t1 t2 acc nb)
