      :n :limit :chunk-end :window :shift :k :back
      :wpos :wacc :wnbits :exit :tmp :tmp2 :ins :cpy :dist :lend :nc :c39flag
      ;; q1 second pass
      :ci :wcap :n8
      ;; quick matchers (q2-q4)
      :pos :insert :ncmd :c0 :c1 :c2 :c3 :apply-rh :store-end :cmdcap
      :cur :bestin :key :bscore :olen :odist :oscore :len :score :delayed
      :mulc :n9 :n7 :fli :fback
      ;; trivial writer (q2-q4)
      :ring0 :ring1 :ring2 :ring3 :ringidx :short-dist :icode :ccode :lstart
      ;; H6 (q5-q9): distance cache, ring walk state
      :dc0 :dc1 :dc2 :dc3 :dc4 :dc5 :dc6 :dc7 :dc8 :dc9 :dc10 :dc11 :dc12 :dc13 :dc14 :dc15
      :hbase :hdown :hfirst4 :hnk :rhwin :hmaxb))
  (defparameter *q0-ctx-slots*
    '(:data :table :out :litlut :cmdlut :inslut :copylut :clastlut :distlut
      ;; q1 (record mode): command vector, histograms, code-number LUTs
      :cv :litf :cmdf :distf :inscc :copycc :clastcc
      ;; q1 second pass: per-length (extra << 16 | bits << 8 | code) words
      :insx :copyx :clastx
      ;; quick matchers
      :buckets :cmds
      ;; trivial writer
      :inslc :cpylc :insbase :insbits :cpybase :cpybits :cmdsym :lit4
      :num))
  (defmacro define-q0-slot-constants ()
    `(progn
       ,@(loop for s in *q0-st-slots* for i from 0
               collect `(defconstant ,(intern (format nil "+Q0-~A+" s) "CL-BROTLI.LISP") ,i))
       (defconstant cl-brotli.lisp::+q0-st-size+ ,(length *q0-st-slots*))
       ,@(loop for s in *q0-ctx-slots* for i from 0
               collect `(defconstant ,(intern (format nil "+Q0C-~A+" s) "CL-BROTLI.LISP") ,i))
